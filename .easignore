/huawei/
/igpsport/
/images/
/press/
/deploy.sh
/google-services.json
/GoogleService-Info*.plist
/fitmeet-release.keystore.backup
/*.png
/*.jpg
/*.mp3
/*.mp4
/*.pdf
/*.zip
/*.docx
/*.ips
*.p8

