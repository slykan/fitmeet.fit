# No directory listings (AdSense/SEO: "Index of" pages look like an abandoned site)
Options -Indexes

RewriteEngine On
RewriteBase /

# HTTPS redirect
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Social crawlers on /events/share -> API OG endpoint
RewriteCond %{REQUEST_URI} ^/events/share
RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|rogerbot|embedly|pinterest|vkShare|Iframely|MetaInspector" [NC]
RewriteRule ^events/share/? https://api.fitmeet.fit/api/events/og?%{QUERY_STRING} [R=302,L]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/?$ /.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
