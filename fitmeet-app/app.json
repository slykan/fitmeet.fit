{
  "expo": {
    "name": "FitMeet",
    "slug": "fitmeet-app",
    "scheme": "fitmeet",
    "version": "1.4.29",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./fitmeet_intro_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "./plugins/withModularHeaders",
      "expo-font",
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "FitMeet needs photo access to save images.",
          "savePhotosPermission": "FitMeet needs access to save images to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FitMeet shares your live position with other checked-in participants during an event, including while your phone is locked or in your pocket, so the group can see where everyone is on the route.",
          "locationWhenInUsePermission": "FitMeet uses your location to show nearby sports events.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "fit.fitmeet.app",
      "buildNumber": "18",
      "associatedDomains": [
        "applinks:fitmeet.fit"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FitMeet uses your location to show nearby sports events.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FitMeet shares your live position with other checked-in participants during an event, including while your phone is locked or in your pocket, so the group can see where everyone is on the route.",
        "NSCameraUsageDescription": "FitMeet needs camera access to upload event moment photos.",
        "NSPhotoLibraryUsageDescription": "FitMeet needs photo library access to upload event moment photos.",
        "NSPhotoLibraryAddUsageDescription": "FitMeet saves photos to your library.",
        "NSMotionUsageDescription": "FitMeet tracks activity during events.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["fit.fitmeet.app"]
          }
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "app.fitmeet.fit",
      "versionCode": 299,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fitmeet.fit",
              "pathPrefix": "/events/share"
            },
            {
              "scheme": "https",
              "host": "fitmeet.fit",
              "pathPrefix": "/events/view"
            },
            {
              "scheme": "https",
              "host": "fitmeet.fit",
              "pathPrefix": "/events/check-in"
            },
            {
              "scheme": "https",
              "host": "fitmeet.fit",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.fitmeet.fit/api",
      "revenueCatGoogleApiKey": "goog_bYVILzxmdRkZxGcbQtQoAUIsMxL",
      "revenueCatAppleApiKey": "appl_RByPQgpqNFAlNUcyliKZqJsSDav",
      "revenueCatSupportProductIds": [
        "beer_small",
        "beer_medium",
        "beer_large"
      ],
      "stravaClientId": "234864",
      "googleAndroidClientId": "206851995035-f0vleunetrb0nqog6dm24e1j1aq6tgqa.apps.googleusercontent.com",
      "googleIosClientId": "206851995035-ojpju360jnjhbogugko32a1eh6gpf6d5.apps.googleusercontent.com",
      "googleWebClientId": "206851995035-0cn2pik52tpaprm9hsshss7uhehab2h0.apps.googleusercontent.com",
      "eas": {
        "projectId": "1a43ba5c-0223-4b08-a207-bb371cc306b2"
      }
    }
  }
}
