{
  "expo": {
    "name": "FitMeet",
    "slug": "fitmeet-app",
    "scheme": "fitmeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050816"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.fitmeetapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.fitmeet.fit/api"
    }
  }
}
